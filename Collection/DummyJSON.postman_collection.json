		{
			"name": "Users",
			"item": [
				{
					"name": "users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const usersData = pm.response.json();\r",
									"\r",
									"pm.test(\"Valida el status 200 OK\",() => {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Valida que la respuesta del servidor es menor a 1 segundo\",()=>{\r",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
									"});\r",
									"\r",
									"pm.test(\"Valida que la lista de usuarios no este vacía\",()=>{\r",
									"pm.expect(usersData.users).to.be.an(\"array\").that.is.not.empty;\r",
									"});\r",
									"\r",
									"pm.test(\"Valida las principales propiedades del usuario\", () => {\r",
									"    usersData.users.forEach((user) => {\r",
									"        pm.expect(user).to.have.property(\"id\").and.to.be.a(\"number\").and.to.not.be.null;\r",
									"        pm.expect(user).to.have.property(\"username\").and.to.be.a(\"string\").and.to.not.be.null;\r",
									"        pm.expect(user).to.have.nested.property(\"address.country\").and.to.be.a(\"string\").and.to.not.be.null;\r",
									"        pm.expect(user).to.have.nested.property(\"company.title\").and.to.be.a(\"string\").and.to.not.be.null;\r",
									"        pm.expect(user).to.have.nested.property(\"company.address.country\").and.to.be.a(\"string\").and.to.not.be.null;\r",
									"        pm.expect(user).to.have.property(\"role\").and.to.be.a(\"string\").and.to.not.be.null;\r",
									"    });\r",
									"});\r",
									"\r",
									"\r",
									"\r",
									"\r",
									"\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users"
							]
						}
