								}
							}
						},
						"url": {
							"raw": "{{base_url}}/users/search?q={{searchName}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "{{searchName}}"
								}
							]
						}
					},
					"response": []
				}
			]
