				},
				{
					"name": "search user - happy path",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();\r",
									"const searchName = pm.collectionVariables.get(\"searchName\");\r",
									"\r",
									"const expectedValidResults = [\"Michael\", \"Emily\"];\r",
									"const expectedEmptyResults = [\"George\", \"Walter\"];\r",
									"\r",
									"if (!searchName) {\r",
									"    console.warn(\"⚠️ No hay nombre definido. Se finalizó el ciclo de pruebas.\");\r",
									"    return;\r",
									"};\r",
									"\r",
									"if (expectedEmptyResults.includes(searchName)) {\r",
									"\r",
									"    pm.test(\"Valida cuando el usuario ingresado no tiene datos\", () => {\r",
									"        pm.expect(response.users.length).to.eql(0);\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida que la estructura de respuesta no tengan datos\", () => {\r",
									"        pm.expect(response).to.have.property(\"users\").that.is.an(\"array\").and.is.empty;\r",
									"        pm.expect(response).to.have.property(\"total\").that.is.a(\"number\").and.is.eql(0);\r",
									"        pm.expect(response).to.have.property(\"skip\").and.is.eql(0);\r",
									"        pm.expect(response).to.have.property(\"limit\").and.is.eql(0);\r",
									"\r",
									"    });\r",
									"\r",
									"} else if (expectedValidResults.includes(searchName)) {\r",
									"\r",
									"    pm.test(`Valida que la busqueda sea segun el nombre ingresado: ${searchName}`, () => {\r",
									"        pm.expect(response.users).to.be.an(\"array\").that.is.not.empty;\r",
									"        response.users.forEach(user => {\r",
									"            pm.expect(user.firstName.toLowerCase()).to.include(searchName.toLowerCase());\r",
									"        });\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida que el usuario tiene sus propiedades claves\", () => {\r",
									"        response.users.forEach(user => {\r",
									"            pm.expect(user).to.have.property(\"id\").that.is.a(\"number\");\r",
									"            pm.expect(user).to.have.property(\"username\").that.is.a(\"string\");\r",
									"            pm.expect(user).to.have.property(\"email\").that.is.a(\"string\");\r",
									"        })\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida la estructura de respuesta contiene las propiedades clave\", () => {\r",
									"        pm.expect(response).to.have.property(\"users\").that.is.an(\"array\");\r",
									"        pm.expect(response).to.have.property(\"total\").that.is.a(\"number\");\r",
									"        pm.expect(response).to.have.property(\"skip\");\r",
									"        pm.expect(response).to.have.property(\"limit\");\r",
									"\r",
									"    });\r",
									"\r",
									"    if (response.users.length > 1) {\r",
									"        pm.test(\"Validar si los usuarios están ordenados por ID ascendente\", () => {\r",
									"            const ids = response.users.map(u => u.id);\r",
									"            const sorted = [...ids].sort((a, b) => a - b);\r",
									"            pm.expect(ids).to.eql(sorted);\r",
									"        });\r",
									"    }\r",
									"\r",
									"} else {\r",
									"    pm.expect.fail(`El nombre \"${searchName}\" no está definido como válido ni vacío en los tests.`);\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
