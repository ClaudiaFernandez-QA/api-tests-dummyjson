				{
					"name": "search user - invalid input",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();\r",
									"const inputTested = pm.collectionVariables.get(\"invalid_input\");\r",
									"\r",
									"if (!inputTested) {\r",
									"    console.warn(\"⚠️ No hay input definido. Se finalizó el ciclo de pruebas.\");\r",
									"    return;\r",
									"}\r",
									"\r",
									"pm.test(`Valida Status 200 - con el input inválido \"${inputTested}\"`, () => {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"//Para inputs vacíos el servicio devuelve todos los usuarios\r",
									"if (inputTested === \"     \") {\r",
									"    pm.test(\"Este input devuelve todos los usuarios (hallazgo documentado)\", () => {\r",
									"        pm.expect(response.users.length).to.be.greaterThan(0);\r",
									"    });\r",
									"} else {\r",
									"    // Validamos que no haya resultados para el resto de los inputs\r",
									"    pm.test(`Valida que no devulve resultados para input inválido: \"${inputTested}\"`, () => {\r",
									"        pm.expect(response.users).to.be.an(\"array\").that.is.empty;\r",
									"        pm.expect(response.total).to.eql(0);\r",
									"        pm.expect(response.skip).to.eql(0);\r",
									"        pm.expect(response.limit).to.eql(0);\r",
									"    });\r",
									"\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const invalidInputs = [\"123\", \"!@#$\", \"     \", \"null\", \"undefined\"];\r",
									"let currentIndex = parseInt(pm.collectionVariables.get(\"invalidIndex\"));\r",
									"\r",
									"if (isNaN(currentIndex)) {\r",
									"    currentIndex = 0;\r",
									"}\r",
									"\r",
									"if (currentIndex < invalidInputs.length) {\r",
									"    const currentInput = invalidInputs[currentIndex];\r",
									"    pm.collectionVariables.set(\"invalid_input\", currentInput);\r",
									"    pm.collectionVariables.set(\"invalidIndex\", currentIndex + 1);\r",
									"} else {\r",
									"    console.log(\"✅ Se completaron todos los casos de input inválido\");\r",
									"    pm.collectionVariables.unset(\"invalidIndex\");\r",
									"    pm.collectionVariables.unset(\"invalid_input\");\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
