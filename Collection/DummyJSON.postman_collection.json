											"// Se Captura los query params como objeto\r",
											"const params = pm.request.url.query.toObject();\r",
											"const limit = parseInt(params.limit);\r",
											"const skip = parseInt(params.skip);\r",
											"\r",
											"console.log(\"Parametros\", pm.request.url.query);\r",
											"\r",
											"pm.test(\"Valida Status 200 OK\", () => {\r",
											"    pm.response.to.have.status(200);\r",
											"});\r",
											"\r",
											"pm.test(`Valida que devuelve exactamente ${limit} usuarios`, () => {\r",
											"    pm.expect(res.users.length).to.eql(limit);\r",
											"});\r",
											"\r",
											"pm.test(\"Valida el valor de 'limit' coincide con el query param\", () => {\r",
											"    pm.expect(res.limit).to.eql(limit);\r",
											"});\r",
											"\r",
											"pm.test(\"Valida el valor de 'skip' coincide con el query param\", () => {\r",
											"    pm.expect(res.skip).to.eql(skip);\r",
											"});\r",
											"\r",
											"pm.test(\"Valida que el total debe ser mayor al skip\", () => {\r",
											"    pm.expect(res.total).to.be.above(skip);\r",
											"});\r",
