									"    pm.expect(resp).to.have.property(\"accessToken\");\r",
									"    pm.expect(resp.accessToken).to.not.be.null;\r",
									"});\r",
									"\r",
									"//Se guarda el token\r",
									"pm.environment.set(\"auth_token\", resp.accessToken);\r",
									"\r",
									"//Se guarda el ID del usuario\r",
									"pm.environment.set(\"user_id\",resp.id);"
