				{
					"name": "search user - invalid input",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();\r",
									"const inputTested = pm.collectionVariables.get(\"invalid_input\");\r",
									"\r",
									"if (!inputTested) {\r",
									"    console.warn(\"⚠️ No hay input definido. Se finalizó el ciclo de pruebas.\");\r",
									"    return;\r",
									"}\r",
									"\r",
									"pm.test(`Valida Status 200 - con el input inválido \"${inputTested}\"`, () => {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"//Para inputs vacíos el servicio devuelve todos los usuarios\r",
									"if (inputTested === \"     \") {\r",
									"    pm.test(\"Este input devuelve todos los usuarios (hallazgo documentado)\", () => {\r",
									"        pm.expect(response.users.length).to.be.greaterThan(0);\r",
									"    });\r",
									"} else {\r",
									"    // Validamos que no haya resultados para el resto de los inputs\r",
									"    pm.test(`Valida que no devulve resultados para input inválido: \"${inputTested}\"`, () => {\r",
									"        pm.expect(response.users).to.be.an(\"array\").that.is.empty;\r",
									"        pm.expect(response.total).to.eql(0);\r",
									"        pm.expect(response.skip).to.eql(0);\r",
									"        pm.expect(response.limit).to.eql(0);\r",
									"    });\r",
									"\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const invalidInputs = [\"123\", \"!@#$\", \"     \", \"null\", \"undefined\"];\r",
									"let currentIndex = parseInt(pm.collectionVariables.get(\"invalidIndex\"));\r",
									"\r",
									"if (isNaN(currentIndex)) {\r",
									"    currentIndex = 0;\r",
									"}\r",
									"\r",
									"if (currentIndex < invalidInputs.length) {\r",
									"    const currentInput = invalidInputs[currentIndex];\r",
									"    pm.collectionVariables.set(\"invalid_input\", currentInput);\r",
									"    pm.collectionVariables.set(\"invalidIndex\", currentIndex + 1);\r",
									"} else {\r",
									"    console.log(\"✅ Se completaron todos los casos de input inválido\");\r",
									"    pm.collectionVariables.unset(\"invalidIndex\");\r",
									"    pm.collectionVariables.unset(\"invalid_input\");\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/search?q={{invalid_input}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"users",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "{{invalid_input}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "search user - happy path",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();\r",
									"const searchName = pm.collectionVariables.get(\"searchName\");\r",
									"\r",
									"const expectedValidResults = [\"Michael\", \"Emily\"];\r",
									"const expectedEmptyResults = [\"George\", \"Walter\"];\r",
									"\r",
									"if (!searchName) {\r",
									"    console.warn(\"⚠️ No hay nombre definido. Se finalizó el ciclo de pruebas.\");\r",
									"    return;\r",
									"};\r",
									"\r",
									"if (expectedEmptyResults.includes(searchName)) {\r",
									"\r",
									"    pm.test(\"Valida cuando el usuario ingresado no tiene datos\", () => {\r",
									"        pm.expect(response.users.length).to.eql(0);\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida que la estructura de respuesta no tengan datos\", () => {\r",
									"        pm.expect(response).to.have.property(\"users\").that.is.an(\"array\").and.is.empty;\r",
									"        pm.expect(response).to.have.property(\"total\").that.is.a(\"number\").and.is.eql(0);\r",
									"        pm.expect(response).to.have.property(\"skip\").and.is.eql(0);\r",
									"        pm.expect(response).to.have.property(\"limit\").and.is.eql(0);\r",
									"\r",
									"    });\r",
									"\r",
									"} else if (expectedValidResults.includes(searchName)) {\r",
									"\r",
									"    pm.test(`Valida que la busqueda sea segun el nombre ingresado: ${searchName}`, () => {\r",
									"        pm.expect(response.users).to.be.an(\"array\").that.is.not.empty;\r",
									"        response.users.forEach(user => {\r",
									"            pm.expect(user.firstName.toLowerCase()).to.include(searchName.toLowerCase());\r",
									"        });\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida que el usuario tiene sus propiedades claves\", () => {\r",
									"        response.users.forEach(user => {\r",
									"            pm.expect(user).to.have.property(\"id\").that.is.a(\"number\");\r",
									"            pm.expect(user).to.have.property(\"username\").that.is.a(\"string\");\r",
									"            pm.expect(user).to.have.property(\"email\").that.is.a(\"string\");\r",
									"        })\r",
									"    });\r",
									"\r",
									"    pm.test(\"Valida la estructura de respuesta contiene las propiedades clave\", () => {\r",
									"        pm.expect(response).to.have.property(\"users\").that.is.an(\"array\");\r",
									"        pm.expect(response).to.have.property(\"total\").that.is.a(\"number\");\r",
									"        pm.expect(response).to.have.property(\"skip\");\r",
									"        pm.expect(response).to.have.property(\"limit\");\r",
									"\r",
									"    });\r",
									"\r",
									"    if (response.users.length > 1) {\r",
									"        pm.test(\"Validar si los usuarios están ordenados por ID ascendente\", () => {\r",
									"            const ids = response.users.map(u => u.id);\r",
									"            const sorted = [...ids].sort((a, b) => a - b);\r",
									"            pm.expect(ids).to.eql(sorted);\r",
									"        });\r",
									"    }\r",
									"\r",
									"} else {\r",
									"    pm.expect.fail(`El nombre \"${searchName}\" no está definido como válido ni vacío en los tests.`);\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"//Lista de nombres para testear.\r",
									"const searchValues = [\"Michael\", \"Emily\", \"George\", \"Walter\"];\r",
									"// Michael| Emily --> tienen datos.\r",
									"// George | Walter --> no tienen datos.\r",
									"\r",
									"// Obtenemos el índice actual. Si no está seteado va en 0.\r",
									"let currentIndex = parseInt(pm.collectionVariables.get(\"searchIndex\"));\r",
									"if (isNaN(currentIndex)) {\r",
									"    currentIndex = 0;\r",
									"}\r",
									"\r",
									"if(currentIndex < searchValues.length){\r",
									"    const firstName = searchValues[currentIndex];\r",
									"    // Se setea la variable que s usa en la URL\r",
									"    pm.collectionVariables.set(\"searchName\", firstName);\r",
									"    // Se actualiza el índice para el próximo test\r",
									"    pm.collectionVariables.set(\"searchIndex\",currentIndex + 1);\r",
									"}else {\r",
									"    console.log(\"Ya se probaron todas las variables de busqueda\");\r",
									"    // Se resetea el índice para permitir repetir el ciclo\r",
									"    pm.collectionVariables.unset(\"searchIndex\");\r",
									"    pm.collectionVariables.unset(\"searchName\");\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
